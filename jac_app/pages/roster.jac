import from "@jac/runtime" { Link }
import from ..domain.roster { clamp_min_girls, jersey_label, position_names }
import from ..state.AppState { use_app_state }
def:pub RosterPage() -> JsxPage {
    state = use_app_state(); active = None; for item in state["teams"] { if item.id == state["activeTeamId"] { active = item; break; } }
    has editing_id: str = ""; has form_open: bool = False; has name: str = ""; has jersey: str = ""; has groups: list[str] = ["MID"];
    has gender: str = ""; has notes: str = ""; has availability: str = "active"; has errors: list[str] = []; has search: str = ""; has group_filter: str = "ALL";
    team_players = [player for player in state["players"] if active and player.team_id == active.id];
    filtered = [player for player in team_players if (active and active.sport == "football" or group_filter == "ALL" or group_filter in player.preferred_groups) and (not search.strip() or search.strip().lower() in player.name.lower())];
    def toggle_group(group: str) { groups = [item for item in groups if item != group] if group in groups else groups + [group]; }
    def open_new { editing_id = ""; name = ""; jersey = ""; groups = ["MID"]; gender = ""; notes = ""; availability = "active"; errors = []; form_open = True; }
    def open_edit(player: any) { editing_id = player.id; name = player.name; jersey = "" if player.jersey_number is None else str(player.jersey_number); groups = player.preferred_groups; gender = player.gender or ""; notes = player.notes or ""; availability = player.availability; errors = []; form_open = True; }
    def submit(e: FormEvent) {
        e.preventDefault(); number: int | None = None;
        if jersey.strip() { try { number = int(jersey); } except Exception { errors = ["Jersey number must be a non-negative whole number, or left blank."]; return; } }
        selected_groups = ["MID"] if active and active.sport == "football" else groups;
        result = state["savePlayer"].call(None, editing_id, name, number, selected_groups, gender if gender else None, notes, availability); errors = result; if not result { form_open = False; }
    }
    def remove(player: any) { if window.confirm("Delete " + player.name + "? Past match history will be kept.") { state["deletePlayer"].call(None, player.id); } }
    if not active { return <section className="page narrow-page"><p>Loading team…</p></section>; }
    <section className="page roster-page"><div className="title-row"><div><h1>{active.name} roster</h1><p className="muted">{"Football team" if active.sport == "football" else ("Co-ed · at least " + str(clamp_min_girls(active.min_girls_on_field)) + " girls on the field" if active.coed else "Soccer team")} {" "}<Link to="/team/settings">Team settings</Link></p></div><button className="button primary" type="button" onClick={open_new}>+ Add player</button></div>
        <div className="filters"><input className="input" type="search" placeholder="Search by name…" value={search} onChange={lambda (e: ChangeEvent) { search = e.target.value; }} />{<select value={group_filter} onChange={lambda (e: ChangeEvent) { group_filter = e.target.value; }}><option value="ALL">All positions</option><option value="GK">Goalkeeper</option><option value="DEF">Defender</option><option value="MID">Midfielder</option><option value="FWD">Forward</option></select> if active.sport != "football" else None}</div>
        {<p className="empty-state">No players yet. Add your first player to get started.</p> if not team_players else None}
        <ul className="roster-list">{[<li key={player.id}><div className="player-avatar">{player.name.strip()[0].upper()}</div><div className="player-info"><div><strong>{jersey_label(player.jersey_number)}</strong> {player.name}{<span className="badge">Unavailable</span> if player.availability == "unavailable" else None}</div><small>{"" if active.sport == "football" else position_names(player.preferred_groups)}{(" · " + ("Girl" if player.gender == "girl" else "Boy" if player.gender == "boy" else "Set gender")) if active.coed else ""}{(" · " + player.notes) if player.notes else ""}</small></div><button className="button ghost small" type="button" onClick={lambda { open_edit(player); }}>Edit</button><button className="button ghost small" type="button" onClick={lambda { remove(player); }}>Delete</button></li> for player in filtered]}</ul>
        {<div className="modal-backdrop" onClick={lambda { form_open = False; }}><section className="modal player-modal" role="dialog" aria-modal={True} onClick={lambda (e: MouseEvent) { e.stopPropagation(); }}><h2>{"Edit player" if editing_id else "Add player"}</h2><form className="form-stack" onSubmit={submit} noValidate>
            <label>Display name<input className="input" required value={name} onChange={lambda (e: ChangeEvent) { name = e.target.value; }} /></label><label>Jersey number (optional)<input className="input" type="number" min="0" value={jersey} onChange={lambda (e: ChangeEvent) { jersey = e.target.value; }} /></label>
            {<fieldset><legend>Positions</legend><p className="muted small-text">Choose every position they can play.</p>{[<label className="check-row" key={group}><input type="checkbox" checked={group in groups} onChange={lambda { toggle_group(group); }} /> {label}</label> for (group, label) in [("GK", "Goalkeeper"), ("DEF", "Defender"), ("MID", "Midfielder"), ("FWD", "Forward")]]}</fieldset> if active.sport != "football" else None}
            {<fieldset><legend>Gender</legend><div className="inline-options"><label><input type="radio" name="gender" checked={gender == "girl"} onChange={lambda { gender = "girl"; }} /> Girl</label><label><input type="radio" name="gender" checked={gender == "boy"} onChange={lambda { gender = "boy"; }} /> Boy</label></div></fieldset> if active.coed else None}
            <fieldset><legend>Availability</legend><div className="inline-options"><label><input type="radio" name="availability" checked={availability == "active"} onChange={lambda { availability = "active"; }} /> Active</label><label><input type="radio" name="availability" checked={availability == "unavailable"} onChange={lambda { availability = "unavailable"; }} /> Unavailable</label></div></fieldset>
            <label>Notes (optional)<textarea className="input" rows={2} value={notes} onChange={lambda (e: ChangeEvent) { notes = e.target.value; }} /></label>{[<p className="error" role="alert" key={idx}>{message}</p> for (idx, message) in enumerate(errors)]}<div className="actions"><button className="button ghost" type="button" onClick={lambda { form_open = False; }}>Cancel</button><button className="button primary" type="submit">{"Save changes" if editing_id else "Add player"}</button></div>
        </form></section></div> if form_open else None}
    </section>
}
